# ashare-monitor 环境变量模板
# 用法：复制为 .env（gitignored），按提示填写。
#   在 Windows:  copy .env.example .env
#   在 Git Bash: cp .env.example .env

# ---------- Webhook 推送通道（重要！3 个自动化推送都靠它） ----------
# 支持：企业微信机器人 / 钉钉机器人 / 飞书机器人 / 任意可收 POST 的 URL
# 企业微信群机器人示例（在群里添加机器人后复制 Webhook 地址）：
ASHARE_MONITOR_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
# 钉钉机器人：
# ASHARE_MONITOR_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的token

# ---------- HuggingFace 端点（可选，默认 hf-mirror.com 国内镜像） ----------
# HF_ENDPOINT=https://huggingface.co
